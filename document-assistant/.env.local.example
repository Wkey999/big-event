# Local-only Python document assistant settings. Copy to .env.local.
# Fill only the value after EMBEDDING_API_KEY=. Do not send the key in chat.
# This is a plain KEY=value file, not executable shell code.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MIN_SCORE=0.35
VECTOR_CACHE_DIR=.vector-cache
