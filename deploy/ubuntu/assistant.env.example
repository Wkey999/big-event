# Optional Python-only config: copy to /etc/boom/assistant.env with mode 600.
# It is a systemd EnvironmentFile, not shell. Never commit a filled copy.
# Empty key keeps the offline feature-hash baseline; no model API requests.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
# Prototype cutoff, not a universal model threshold; calibrate on a separate dataset.
EMBEDDING_MIN_SCORE=0.35
# Private disposable vector cache; the service creates /var/lib/boom-assistant.
VECTOR_CACHE_DIR=/var/lib/boom-assistant/indexes
