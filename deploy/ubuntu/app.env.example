# Copy to /etc/boom/app.env; never commit the filled copy.
# systemd EnvironmentFile syntax, NOT shell: no export or command substitutions.
DB_USERNAME=boom
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_ASCII_CHARACTERS

# Reuse the current OSS bucket so existing image URLs remain valid.
# Internal endpoints work only when bucket and ECS share the same region.
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_BASE_URL=
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Enable server title translation only after verifying the model and billing.
LLM_ENABLED=false
LLM_CHAT_PROVIDER=none
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

AI_TRIAL_ENABLED=false
AI_TRIAL_API_KEY=
APP_AI_TRIAL_DAILY_USER_LIMIT=3
APP_AI_TRIAL_DAILY_IP_LIMIT=10
APP_AI_TRIAL_DAILY_SITE_LIMIT=50
APP_CONTENT_FEEDS_ENABLED=false
APP_CONTENT_FEEDS_AUTO_PUBLISH_ENABLED=false
