<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.mapper.ArticleMapper">

    <!-- 全站共享后信息流里会出现别人的文章，列表必须带上真实作者（昵称/头像），
         否则前端只能拿当前登录用户去填，每张卡片都显示成浏览者自己 -->
    <select id="findByCondition" resultType="com.itheima.pojo.Article">
        SELECT a.*, u.nickname AS author_nickname, u.avatar AS author_avatar
        FROM article a
        LEFT JOIN user u ON u.id = a.user_id
        WHERE a.deleted = 0
        <choose>
            <!-- 已发布：全站共享，任何人可看（首页信息流） -->
            <when test="state == 1">
                AND a.state = 1
            </when>
            <!-- 草稿或不筛选：普通用户仅作者本人（管理页）；管理员 userId 传 null = 全站所有文章(含草稿) -->
            <otherwise>
                <if test="userId != null">
                    AND a.user_id = #{userId}
                </if>
                <if test="state != null">
                    AND a.state = #{state}
                </if>
            </otherwise>
        </choose>
        <if test="categoryId != null">
            AND a.category_id = #{categoryId}
        </if>
        ORDER BY a.create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*) FROM article a
        WHERE a.deleted = 0
        <choose>
            <when test="state == 1">
                AND a.state = 1
            </when>
            <otherwise>
                <if test="userId != null">
                    AND a.user_id = #{userId}
                </if>
                <if test="state != null">
                    AND a.state = #{state}
                </if>
            </otherwise>
        </choose>
        <if test="categoryId != null">
            AND a.category_id = #{categoryId}
        </if>
    </select>

</mapper>
